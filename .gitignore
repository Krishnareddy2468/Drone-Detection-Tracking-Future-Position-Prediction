# ---------------------------------------------------------------------------
# Training runs & model weights
# ---------------------------------------------------------------------------
# Ultralytics writes every training run here (weights, plots, args.yaml with
# absolute local paths). Regenerate with src/train_detector.py.
runs/

# YOLO weights: yolov8n.pt is downloaded automatically by ultralytics; any
# fine-tuned best.pt is a build artifact.
yolov8n.pt
*best.pt
*last.pt

# Benchmark scratch checkpoints (regenerated by src/benchmark.py)
lstm_bench_*.pt

# The trained LSTM checkpoints in models/ ARE tracked — they are ~80 KB and
# make the demo runnable out of the box.
!models/lstm_traj.pt
!models/lstm_traj_free.pt

